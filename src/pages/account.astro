---
import Layout from '../layouts/Layout.astro';
import AccountIsland from '../components/AccountIsland.tsx';
import { effectiveDailyWindowStart } from '../lib/resolution/budgetPolicy';

export const prerender = false;

// Protected by middleware — locals.user is non-null here.
const user = Astro.locals.user!;

const { data: profile } = await Astro.locals.supabase
  .from('profiles')
  .select('display_name, ai_resolution_max_calls_per_day, ai_resolution_daily_reset_at')
  .eq('id', user.id)
  .single();

const initialDisplayName = profile?.display_name ?? null;
const initialMaxCallsPerDay = profile?.ai_resolution_max_calls_per_day ?? 20;

const dailyWindowStart = effectiveDailyWindowStart(
  new Date(),
  profile?.ai_resolution_daily_reset_at ?? null,
);
// .eq('user_id', ...) explicite obok RLS — belt-and-suspenders, zgodnie z istniejącym stylem repo.
const { count: initialUsageTodayCount } = await Astro.locals.supabase
  .from('resolution_calls')
  .select('id', { count: 'exact', head: true })
  .eq('user_id', user.id)
  .gte('created_at', dailyWindowStart.toISOString());
const initialUsageToday = initialUsageTodayCount ?? 0;
---

<Layout title="Moje konto">
  <main class="mx-auto max-w-2xl p-4 sm:p-8">
    <h1 class="mb-6 text-3xl font-bold">Moje konto</h1>
    <AccountIsland
      client:load
      initialDisplayName={initialDisplayName}
      userEmail={user.email ?? ''}
      initialMaxCallsPerDay={initialMaxCallsPerDay}
      initialUsageToday={initialUsageToday}
    />
  </main>
</Layout>
