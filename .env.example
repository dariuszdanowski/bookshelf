# Supabase — z dashboardu projektu (Settings → API)
PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=<your-anthropic-key>

# Google Books API — opcjonalne, zwiększa rate limit z 1k/dzień
# https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# Cloudflare Web Analytics — opcjonalny, browser-side beacon (S-51). Token nie
# jest sekretem (widoczny w źródle strony) — puste = brak beacon scriptu w
# Layout.astro. Dashboard → Analytics & Logs → Web Analytics → Add a site.
PUBLIC_CF_BEACON_TOKEN=

# Embeddingi do wektorowego indeksu context/ dla agenta (scripts/build-context-index.mjs).
# Wariant lokalny (LM Studio, OpenAI-compatible endpoint):
EMBEDDING_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe
# EMBEDDING_API_KEY=
#
# Wariant cf-llm-relay:
# EMBEDDING_URL=https://cf-llm-relay.dariusz-danowski-559.workers.dev/v1
# EMBEDDING_MODEL=mId-lmstudio::text-embedding-nomic-embed-text-v2-moe
# EMBEDDING_API_KEY=${CF_PUBLIC_API_KEY}
